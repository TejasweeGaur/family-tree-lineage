// Cloudflare Workers config: serves the built site from dist/ as static
// assets. There is no Worker script — requests for static assets are free.
{
  // Must match the project name in the Cloudflare dashboard.
  "name": "family-tree-lineage",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    // Unknown paths get index.html rather than a 404, as an SPA expects.
    "not_found_handling": "single-page-application"
  }
}
